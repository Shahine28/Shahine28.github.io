---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props
{
    projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---
<section class="grid">
    {projects.map((project, index) => (
        <a class="card" href={'/' + project.id}>
            <Image
                src={project.data.cover}
                alt=""
                widths={[640, 960, 1280]}
                sizes="(max-width: 700px) 100vw, 50vw"
                loading={index < 2 ? 'eager' : 'lazy'}
            />
            <div class="details">
                <h2>{project.data.title}{project.data.tagline && ' - ' + project.data.tagline}</h2>
                <p>{project.data.year} - {project.data.duration}</p>
                <p>{project.data.tech} - {project.data.roles}</p>
                <p>{project.data.teamSize}</p>
            </div>
        </a>
    ))}
</section>

<style>
    .grid
    {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 4px;
    }

    @media (max-width: 700px)
    {
        .grid
        {
            grid-template-columns: 1fr;
        }
    }

    .card
    {
        position: relative;
        display: block;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        text-decoration: none;
        background: var(--bg-elevated);
    }

    .card img
    {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    /* Details sit over the cover and fade in on hover, like the old site. Always visible on touch screens. */
    .details
    {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 0.1rem;
        padding: 1.5rem;
        text-align: center;
        background: rgba(0, 0, 0, 0.7);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .details h2
    {
        font-size: clamp(1.3rem, 2.4vw, 1.8rem);
        margin-bottom: 0.4rem;
    }

    .details p
    {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .card:hover .details,
    .card:focus-visible .details
    {
        opacity: 1;
    }

    .card:hover img
    {
        transform: scale(1.04);
    }

    @media (hover: none)
    {
        .details
        {
            opacity: 1;
            justify-content: flex-end;
            background: linear-gradient(transparent 35%, rgba(0, 0, 0, 0.85));
        }
    }
</style>
