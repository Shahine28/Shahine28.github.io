---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveVideo } from '../lib/media';

type Item = { image: ImageMetadata; caption?: string } | { video: string; caption?: string };

interface Props
{
    projectId: string;
    items: Item[];
}

const { projectId, items } = Astro.props;
---
{items.length > 0 && (
    <div class="gallery">
        {items.map((item) => (
            <figure>
                {'image' in item
                    ? <Image src={item.image} alt={item.caption ?? ''} widths={[640, 1100, 1920]} sizes="(max-width: 700px) 100vw, 1100px" />
                    : <video src={resolveVideo(projectId, item.video)} autoplay loop muted playsinline preload="metadata" aria-label={item.caption}></video>}
                {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
        ))}
    </div>
)}

<style>
    .gallery
    {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem 1.2rem;
        align-items: start;
        margin: 3rem 0;
    }

    /* With an odd count, the first item (usually a banner or the main shot) takes the full row so the grid stays even. */
    .gallery:has(> figure:last-child:nth-child(odd)) > figure:first-child
    {
        grid-column: 1 / -1;
    }

    @media (max-width: 700px)
    {
        .gallery
        {
            grid-template-columns: 1fr;
        }
    }

    figure
    {
        margin: 0;
    }

    figure img,
    figure video
    {
        width: 100%;
        border-radius: 4px;
    }

    figcaption
    {
        margin-top: 0.6rem;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
</style>
