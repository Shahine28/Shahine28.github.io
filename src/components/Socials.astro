---
import { siGithub } from 'simple-icons';
import { SITE } from '../lib/site';

interface Props
{
    size?: number;
}

const { size = 22 } = Astro.props;
---
<ul class="socials">
    <li>
        <a href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <!-- simple-icons dropped LinkedIn for brand reasons, so this is a plain hand-drawn glyph -->
            <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <rect x="2" y="9" width="4.2" height="13" />
                <circle cx="4.1" cy="4.4" r="2.4" />
                <path d="M9 9h4v1.9c.6-1.1 2.1-2.2 4.3-2.2 4.3 0 5.1 2.8 5.1 6.5V22h-4.2v-6.1c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3V22H9z" />
            </svg>
        </a>
    </li>
    <li>
        <a href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub">
            <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg>
        </a>
    </li>
    <li>
        <a href={'mailto:' + SITE.email} aria-label="Email">
            <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M2 5h20v14H2zm2 2v.5l8 5.2 8-5.2V7zm0 2.9V17h16V9.9l-8 5.2z" />
            </svg>
        </a>
    </li>
</ul>

<style>
    .socials
    {
        display: flex;
        gap: 1.1rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .socials a
    {
        color: var(--text);
        display: block;
        transition: opacity 0.2s;
    }

    .socials a:hover
    {
        opacity: 0.6;
    }
</style>
