---
import heroVideo from '../assets/hero.mp4?url';

interface Props
{
    // Short heroes (Games page) only carry a title, the full one (Home) carries everything in the slot.
    size?: 'full' | 'short';
    scrollTarget: string;
}

const { size = 'full', scrollTarget } = Astro.props;
---
<section class:list={['hero', size]}>
    <video class="hero-video" src={heroVideo} autoplay loop muted playsinline aria-hidden="true"></video>
    <div class="hero-content">
        <slot />
    </div>
    <a class="scroll-hint" href={'#' + scrollTarget} aria-label="Scroll to content">⌄</a>
</section>

<style>
    /* The header sits on top of the hero, so the hero pulls itself up under it. */
    .hero
    {
        position: relative;
        display: grid;
        place-items: center;
        margin-top: -84px;
        overflow: hidden;
        text-align: center;
    }

    .full
    {
        min-height: 88vh;
    }

    .short
    {
        min-height: 60vh;
    }

    .hero-video
    {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hero::after
    {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.15);
    }

    .hero-content
    {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 0 var(--gutter);
    }

    .hero-content :global(h1)
    {
        font-size: clamp(2.8rem, 8vw, 5.5rem);
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
    }

    .scroll-hint
    {
        position: absolute;
        bottom: 1.2rem;
        z-index: 1;
        font-size: 2rem;
        text-decoration: none;
        opacity: 0.7;
    }
</style>
